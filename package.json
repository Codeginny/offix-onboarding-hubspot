{
  "name": "offix",
  "version": "0.1.0",
  "description": "Demo de Visuali conectada a HubSpot: onboarding de clientes y seguimiento con datos ficticios",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.web.json",
    "prestart": "npm run build",
    "start": "node server.ts",
    "predev": "npm run build",
    "dev": "node --watch server.ts",
    "test": "node --test pruebas/*.test.ts",
    "typecheck": "tsc && tsc -p tsconfig.web.json --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3"
  }
}
